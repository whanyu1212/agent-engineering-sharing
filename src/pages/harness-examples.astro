---
import { Code } from 'astro:components';
import SiteLayout from '../layouts/SiteLayout.astro';

const runnerCode = `from google.adk.runners import Runner
from google.adk.sessions import InMemorySessionService
from google.genai import types

session_service = InMemorySessionService()

session = await session_service.create_session(
    app_name="maintenance_agent",
    user_id="operator-7",
    state={"line": "press-2", "machine_id": "M-42"},
)

runner = Runner(
    agent=root_agent,
    app_name="maintenance_agent",
    session_service=session_service,
)

message = types.Content(
    role="user",
    parts=[types.Part(text="Diagnose alarm E118 on M-42")],
)

async for event in runner.run_async(
    user_id="operator-7",
    session_id=session.id,
    new_message=message,
):
    if event.is_final_response():
        print(event.content.parts[0].text)`;

const confirmationsCode = `from google.adk.agents import Agent
from google.adk.tools import FunctionTool

root_agent = Agent(
    model="gemini-2.5-flash",
    name="maintenance_agent",
    instruction=(
        "Diagnose manufacturing issues. "
        "Never create work orders without confirmation."
    ),
    tools=[
        read_alarm_history,
        fetch_sensor_window,
        FunctionTool(create_work_order, require_confirmation=True),
    ],
)`;

const hitlCode = `import hashlib
import json
import uuid

from pydantic import BaseModel, ConfigDict, StrictBool, StrictStr, ValidationError

from google.adk import Workflow
from google.adk.events import RequestInput


class WorkflowStateCorruption(Exception):
    """Raised when resume state is internally inconsistent — surfaces the
    condition without firing a side effect so a retry-loop cannot amplify
    the corruption. The workflow harness should park the run for repair.
    """


# Typed contract for the reviewer response. ADK does not coerce, AND we
# don't want Pydantic to either — at a human-control boundary, "true", 1,
# or "yes" must be malformed inputs, not coerced approvals. StrictBool +
# strict mode rejects anything that isn't an actual bool / actual str.
class ApprovalDecision(BaseModel):
    model_config = ConfigDict(strict=True)
    approved: StrictBool
    notes: StrictStr = ""


def _proposal_fingerprint(proposal):
    # Content hash — NOT an idempotency key. It detects state drift across
    # the pause; it cannot identify "this approval attempt" because two
    # legitimate approvals for the same machine and alarm hash identically.
    body = json.dumps(proposal, sort_keys=True).encode("utf-8")
    return hashlib.sha256(body).hexdigest()


def propose_work_order(ctx):
    proposal = {
        "machine_id": "M-42",
        "alarm": "E118",
        "recommended_action": "replace pressure sensor",
    }
    # Mint a durable operation id ONCE, at proposal time. This is the unique
    # identity of THIS approval attempt and what create_work_order dedupes
    # on. Retries of the same run reuse it; a later approval for the same
    # machine gets a fresh one.
    operation_id = str(uuid.uuid4())

    # Carry the proposal, the operation id, and a content fingerprint
    # through workflow state. RequestInput's payload is request context for
    # the UI; only state survives the pause and resume.
    ctx.state["pending_proposal"] = proposal
    ctx.state["pending_operation_id"] = operation_id
    ctx.state["pending_fingerprint"] = _proposal_fingerprint(proposal)
    return proposal


def request_supervisor_approval(proposal):
    yield RequestInput(
        message=f"Approve work order for {proposal['machine_id']}?",
        payload=proposal,
        response_schema=ApprovalDecision.model_json_schema(),
    )


def route_after_review(ctx, raw_response):
    # The workflow may have resumed hours later — possibly more than once if
    # an earlier resume crashed mid-flight. READ state, do not pop it: we
    # only clear it after the terminal side effect durably completes.
    proposal = ctx.state.get("pending_proposal")
    operation_id = ctx.state.get("pending_operation_id")
    fingerprint = ctx.state.get("pending_fingerprint")

    # Recovery handle, SCOPED. 'last_operation_id' rescues the post-crash
    # case where pending_operation_id was already cleared but the workflow
    # is being asked to re-run the resume step. Only consult it when there
    # is NO pending state at all — otherwise a partial rehydration of a new
    # approval could pick up a previous approval's id and silently return
    # its cached result.
    no_pending_state = (
        proposal is None and operation_id is None and fingerprint is None
    )
    if operation_id is None and no_pending_state:
        operation_id = ctx.state.get("last_operation_id")

    # No trustworthy operation_id → raise, never side-effect. An escalation
    # here would page the on-call once per retry. Let the harness park the
    # run for operator repair.
    if operation_id is None:
        raise WorkflowStateCorruption(
            "approval resumed with no operation_id and no recovery handle"
        )

    # From here on we have an operation id, so every exit writes the
    # terminal slot before returning. A retry that re-enters with the same
    # id will hit the presence check below and short-circuit.
    terminal_slot = f"terminal:{operation_id}"

    # If a previous attempt already finished, return that result instead of
    # firing the side effect again. Use PRESENCE, not truthiness — a valid
    # terminal result can be None, False, or {} and must still short-circuit.
    if terminal_slot in ctx.state:
        cached = ctx.state[terminal_slot]
        ctx.state.pop("pending_proposal", None)
        ctx.state.pop("pending_operation_id", None)
        ctx.state.pop("pending_fingerprint", None)
        return cached

    # Partial rehydration: operation_id is here but the proposal is not.
    # Do NOT side-effect on this path — escalating retry-loops into pages.
    # Raise instead and let the harness park the run for operator repair.
    if proposal is None or fingerprint is None:
        raise WorkflowStateCorruption(
            f"approval resumed with operation_id={operation_id!r} but no "
            "proposal/fingerprint — operator must reconcile this run"
        )
    # Integrity check (see human-handoff page for trust-boundary caveats).
    elif _proposal_fingerprint(proposal) != fingerprint:
        result = escalate_to_engineering(
            proposal,
            operation_id=operation_id,
            reason="proposal fingerprint mismatch on resume",
        )
    else:
        # Validate the human response. Treat malformed input as its own
        # branch — never index a dict you have not parsed.
        try:
            decision = ApprovalDecision.model_validate(raw_response)
        except ValidationError as err:
            result = escalate_to_engineering(
                proposal,
                operation_id=operation_id,
                reason=f"malformed approval response: {err}",
            )
        else:
            if decision.approved:
                # create_work_order MUST treat operation_id as a dedupe
                # token at its own boundary (DB unique constraint, ticket
                # external_id, etc.). Without that, retries here can still
                # duplicate downstream.
                result = create_work_order(
                    proposal, operation_id=operation_id, notes=decision.notes
                )
            else:
                result = escalate_to_engineering(
                    proposal,
                    operation_id=operation_id,
                    reason=decision.notes or "rejected",
                )

    # Record terminal status and pin 'last_operation_id' BEFORE clearing
    # pending entries. If the workflow crashes anywhere in this tail, the
    # next resume reaches the terminal slot (via the pointer if needed) and
    # short-circuits.
    ctx.state[terminal_slot] = result
    ctx.state["last_operation_id"] = operation_id
    ctx.state.pop("pending_proposal", None)
    ctx.state.pop("pending_operation_id", None)
    ctx.state.pop("pending_fingerprint", None)
    return result


root_agent = Workflow(
    name="maintenance_with_hitl",
    edges=[
        ("START", propose_work_order, request_supervisor_approval),
        (request_supervisor_approval, route_after_review, "END"),
    ],
)`;

const evalCode = `{
  "eval_set_id": "manufacturing_diagnostics",
  "name": "Manufacturing diagnostics",
  "eval_cases": [
    {
      "eval_id": "alarm_e118_requires_diagnostics",
      "conversation": [
        {
          "invocation_id": "inv-001",
          "user_content": {
            "parts": [{ "text": "Machine M-42 has alarm E118." }],
            "role": "user"
          },
          "intermediate_data": {
            "tool_uses": [
              { "name": "read_alarm_history",
                "args": { "machine_id": "M-42" } },
              { "name": "fetch_sensor_window",
                "args": { "machine_id": "M-42", "minutes": 30 } }
            ]
          }
        }
      ],
      "session_input": {
        "app_name": "maintenance_agent",
        "user_id": "operator-7",
        "state": { "line": "press-2" }
      }
    }
  ]
}`;

const eventsCode = `async for event in runner.run_async(
    user_id="operator-7",
    session_id=session.id,
    new_message=message,
):
    if event.content and event.content.parts:
        for part in event.content.parts:
            if part.function_call:
                log("tool_call", part.function_call.name, part.function_call.args)
            elif part.function_response:
                log("tool_result", part.function_response.name)
            elif part.text:
                log("model_text", part.text)

    if event.actions and event.actions.state_delta:
        log("state_delta", event.actions.state_delta)

    if event.is_final_response():
        break`;

const theme = 'github-light';
---

<SiteLayout current="harness-examples" title="ADK harness examples">
  <section class="section page-section">
    <div class="section-head">
      <p class="eyebrow">Harness examples</p>
      <h1>Google ADK makes the harness visible.</h1>
      <p>
        The three slots from the previous page — <strong>before model</strong>,
        <strong>during tools</strong>, <strong>after turn</strong> — show up in
        ADK as concrete runtime pieces. With ADK 2.0, the "during tools" slot
        stretches to cover human pauses that may last hours.
      </p>
    </div>

    <div class="mini-diagram react-diagram harness-diagram" aria-label="ADK Components flow" style="margin-bottom: 48px; border-radius: 20px;">
      <svg viewBox="0 0 1080 340" role="img">
        <defs>
          <marker id="adk-arrow" markerHeight="8" markerWidth="8" orient="auto" refX="7" refY="4">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--accent)"></path>
          </marker>
        </defs>

        <rect x="340" y="20" width="340" height="180" rx="20" fill="var(--surface-muted)" stroke="var(--accent)" stroke-width="2" stroke-dasharray="8 4"></rect>
        <text x="510" y="50" text-anchor="middle" fill="var(--muted)" font-size="14" font-weight="700" letter-spacing="0.08em" font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace">THE HARNESS</text>

        <g class="harness-links" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-dasharray="8 8" style="animation: data-flow 1.5s linear infinite; opacity: 0.8;">
          <path d="M 260 120 H 368" marker-end="url(#adk-arrow)"></path>
          <path d="M 640 100 H 768" marker-end="url(#adk-arrow)"></path>
          <path d="M 780 140 H 652" marker-end="url(#adk-arrow)"></path>
          <path d="M 510 160 V 228" marker-end="url(#adk-arrow)"></path>
        </g>

        <style>
          .adk-diagram-text { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; fill: var(--ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
          .adk-diagram-sub { font-size: 13px; font-weight: 600; fill: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
          .adk-diagram-label { font-size: 12px; font-weight: 600; fill: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        </style>

        <text x="314" y="110" class="adk-diagram-label" text-anchor="middle">load turn</text>
        <text x="710" y="90" class="adk-diagram-label" text-anchor="middle">call tools</text>
        <text x="710" y="165" class="adk-diagram-label" text-anchor="middle">return results</text>
        <text x="525" y="200" class="adk-diagram-label" text-anchor="start">eval trace</text>

        <g class="react-node-svg">
          <rect x="40" y="80" width="220" height="80" rx="16"></rect>
          <text x="150" y="114" class="adk-diagram-text" text-anchor="middle">SessionService</text>
          <text x="150" y="138" class="adk-diagram-sub" text-anchor="middle">01 · Before model</text>
        </g>

        <g class="react-node-svg is-planner">
          <rect x="380" y="80" width="260" height="80" rx="40"></rect>
          <text x="510" y="114" class="adk-diagram-text" text-anchor="middle">Runner</text>
          <text x="510" y="138" class="adk-diagram-sub" text-anchor="middle">All · Across turn</text>
        </g>

        <g class="react-node-svg is-critic">
          <rect x="780" y="80" width="240" height="80" rx="40"></rect>
          <text x="900" y="114" class="adk-diagram-text" text-anchor="middle">FunctionTool</text>
          <text x="900" y="138" class="adk-diagram-sub" text-anchor="middle">02 · During tools</text>
        </g>

        <g class="react-node-svg is-done">
          <rect x="380" y="240" width="260" height="80" rx="16"></rect>
          <text x="510" y="274" class="adk-diagram-text" text-anchor="middle">AgentEvaluator</text>
          <text x="510" y="298" class="adk-diagram-sub" text-anchor="middle">03 · After turn</text>
        </g>
      </svg>
    </div>

    <article class="harness-row">
      <div class="harness-row__intro">
        <span>01 · Before model</span>
        <h3>Runner + SessionService load the turn.</h3>
        <p>
          The <code>Runner</code> is the execution loop as an object. It joins an
          agent to a session service that holds state and the event history. The
          session is loaded before the model sees anything.
        </p>
      </div>
      <figure class="code-card">
        <figcaption>
          <span class="lang-pill">python</span>
          <span class="code-filename">adk_runner_session.py</span>
          <a href="https://adk.dev/runtime/event-loop/" target="_blank" rel="noreferrer">ADK event loop</a>
        </figcaption>
        <Code code={runnerCode} lang="python" theme={theme} />
      </figure>
    </article>

    <article class="harness-row">
      <div class="harness-row__intro">
        <span>02 · During tools</span>
        <h3>Confirmations gate side-effecting calls.</h3>
        <p>
          Setting <code>require_confirmation=True</code> on a <code>FunctionTool</code>
          tells the runtime to pause before that tool executes. Refunds, work
          orders, and production writes never happen on the model's say-so alone.
        </p>
      </div>
      <figure class="code-card">
        <figcaption>
          <span class="lang-pill">python</span>
          <span class="code-filename">adk_control_points.py</span>
          <a href="https://adk.dev/tools-custom/confirmation/" target="_blank" rel="noreferrer">ADK confirmations</a>
        </figcaption>
        <Code code={confirmationsCode} lang="python" theme={theme} />
      </figure>
    </article>

    <article class="harness-row">
      <div class="harness-row__intro">
        <span>02 · During tools <span class="beta-pill">ADK 2.0 beta</span></span>
        <h3>Workflow pauses become first-class human-input nodes in ADK 2.0 beta.</h3>
        <p>
          <code>require_confirmation</code> assumes the human answers in seconds.
          Real approvals — refund queues, change-management tickets, shift
          handoffs — take hours. ADK 2.0 beta's <code>RequestInput</code> node
          turns that pause into a persisted workflow step that can resume from
          the event log when the human responds. Useful directionally, but still
          beta rather than stable production guidance.
        </p>
        <p>
          Note the saga-style cleanup: the resume node reads state with
          <code>.get()</code>, hands a UUID <em>operation id</em> (not a
          content hash — two valid approvals for the same machine would
          collide) to <code>create_work_order</code> as a dedupe token,
          checks the terminal slot by <em>presence</em> so a falsy result
          still short-circuits, and only clears pending state <em>after</em>
          recording terminal status. The human-handoff page walks through
          why each of those three pieces matters.
        </p>
      </div>
      <figure class="code-card">
        <figcaption>
          <span class="lang-pill">python</span>
          <span class="code-filename">adk_hitl_workflow.py</span>
          <a href="https://adk.dev/workflows/human-input/" target="_blank" rel="noreferrer">ADK 2.0 human input</a>
        </figcaption>
        <Code code={hitlCode} lang="python" theme={theme} />
      </figure>
    </article>

    <article class="harness-row">
      <div class="harness-row__intro">
        <span>03 · After turn</span>
        <h3>Eval files replay the trajectory as a test.</h3>
        <p>
          If a turn cannot be replayed, it cannot be trusted. ADK eval cases
          assert over the trajectory — which tools were called and with what
          arguments — not just the final answer.
        </p>
      </div>
      <figure class="code-card">
        <figcaption>
          <span class="lang-pill">json</span>
          <span class="code-filename">diagnostics.evalset.json</span>
          <a href="https://adk.dev/evaluate/" target="_blank" rel="noreferrer">ADK evals</a>
        </figcaption>
        <Code code={evalCode} lang="json" theme={theme} />
      </figure>
    </article>

    <article class="harness-row">
      <div class="harness-row__intro">
        <span>All · Across the turn</span>
        <h3>Events are the trace primitive.</h3>
        <p>
          Every user message, model response, tool call, tool result, and state
          delta is an <code>Event</code> appended to the session. Evals replay
          them. Observability streams them. And HITL pauses resume by
          reconstructing them — one event log, three uses.
        </p>
      </div>
      <figure class="code-card">
        <figcaption>
          <span class="lang-pill">python</span>
          <span class="code-filename">adk_event_stream.py</span>
          <a href="https://adk.dev/events/" target="_blank" rel="noreferrer">ADK events</a>
        </figcaption>
        <Code code={eventsCode} lang="python" theme={theme} />
      </figure>
    </article>


  </section>
</SiteLayout>
