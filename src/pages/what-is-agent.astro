---
import { Code } from 'astro:components';
import SiteLayout from '../layouts/SiteLayout.astro';

const agentLoopCode = `while not done:
    context = build_context(state, memory, user_goal)
    action = llm.decide(context, available_tools)
    observation = execute(action)
    state = update_state(state, action, observation)
    done = should_stop(state, observation)`;

const runtimeCode = `final_response_text = None

async for event in runner.run_async(
    user_id=user_id,
    session_id=session_id,
    new_message=content,
):
    # Inspect the stream: author, content parts, actions, and final/displayable status.
    # print(f"[Event] author={event.author}, final={event.is_final_response()}, content={event.content}, actions={event.actions}")

    # Tool calls and tool responses are content parts, not separate event classes.
    for call in event.get_function_calls():
        print(f"tool call: {call.name}({call.args})")

    for response in event.get_function_responses():
        print(f"tool response: {response.name} -> {response.response}")

    if event.actions and event.actions.state_delta:
        print(f"state delta: {event.actions.state_delta}")

    # is_final_response() marks an event suitable for the client to display or act on.
    if event.is_final_response():
        if event.long_running_tool_ids:
            final_response_text = "Long-running tool is pending."
        elif event.content and event.content.parts and event.content.parts[0].text:
            final_response_text = event.content.parts[0].text
        elif event.get_function_responses():
            final_response_text = str(event.get_function_responses()[0].response)
        elif event.actions and event.actions.escalate:
            final_response_text = f"Agent escalated: {event.error_message or 'No specific message.'}"
        else:
            final_response_text = event.error_message or "[final non-text event]"
        break

print(f"<<< Agent Response: {final_response_text or '[no final response emitted]'}")`;
---

<SiteLayout current="agent" title="What is an agent?">
  <section class="section page-section">
    <div class="section-head">
      <p class="eyebrow">Definition</p>
      <h1>Agents are models in a control loop.</h1>
      <p>
        Prompting asks once. An agent keeps state, chooses tools, observes
        what happened, and decides whether to continue.
      </p>
    </div>

    <div class="section-head compact-head" id="compare-framings">
      <p class="eyebrow">Compare the framings</p>
      <h2>Four definitions of "agent," side by side.</h2>
    </div>

    <div class="signal-panel signal-panel--two signal-panel--definitions" style="margin-top: 32px; margin-bottom: 48px;">
      <div>
        <article>
          <span>Google</span>
          <strong>Goal-seeking through observation and action.</strong>
          <p>In its most fundamental form, a Generative AI agent can be defined as an application that attempts to achieve a goal by observing the world and acting upon it using the tools that it has at its disposal.</p>
          <p style="font-size: 0.85rem; color: var(--muted); margin-top: 16px;">Wiesinger, Marlow &amp; Vuskovic, <em>Agents</em> (Google, 2024). <a href="https://www.kaggle.com/whitepaper-agents" target="_blank" rel="noreferrer" style="color: var(--accent); text-decoration: none;">Link</a></p>
        </article>

        <article>
          <span>Hugging Face</span>
          <strong>An AI model that reasons, plans, and interacts.</strong>
          <p>An Agent is a system that leverages an AI model to interact with its environment in order to achieve a user-defined objective. It combines reasoning, planning, and the execution of actions (often via external tools) to fulfill tasks.</p>
          <p style="font-size: 0.85rem; color: var(--muted); margin-top: 16px;"><em>What is an Agent?</em>, Hugging Face Agents Course. <a href="https://huggingface.co/learn/agents-course/unit1/what-are-agents" target="_blank" rel="noreferrer" style="color: var(--accent); text-decoration: none;">Link</a></p>
        </article>

        <article>
          <span>Anthropic</span>
          <strong>The LLM directs its own process.</strong>
          <p>Systems where LLMs dynamically direct their own processes and tool usage, maintaining control over how they accomplish tasks.</p>
          <p style="font-size: 0.85rem; color: var(--muted); margin-top: 16px;">Schluntz &amp; Zhang, <em>Building effective agents</em> (Anthropic, 2024). <a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noreferrer" style="color: var(--accent); text-decoration: none;">Link</a></p>
        </article>

        <article>
          <span>OpenAI</span>
          <strong>Independent execution on the user's behalf.</strong>
          <p>Agents are systems that independently accomplish tasks on your behalf.</p>
          <p style="font-size: 0.85rem; color: var(--muted); margin-top: 16px;">OpenAI, <em>A practical guide to building agents</em> (2025). <a href="https://cdn.openai.com/business-guides-and-resources/a-practical-guide-to-building-agents.pdf" target="_blank" rel="noreferrer" style="color: var(--accent); text-decoration: none;">Link</a></p>
        </article>
      </div>
    </div>

    <div class="agent-grid">
      <aside class="definition-card">
        <span>Distilled definition</span>
        <p>
          A goal-directed program where an LLM repeatedly decides the next
          action, uses tools, reads observations, and updates state until the
          task is done.
        </p>
      </aside>

      <div class="loop-diagram" aria-label="Agent execution loop">
        <svg viewBox="0 0 640 280" role="img" aria-labelledby="loop-title">
          <title id="loop-title">Agent loop: user goal, decide, act, observe, update or stop</title>
          <defs>
            <marker id="loop-arrow" markerHeight="8" markerWidth="8" orient="auto" refX="7" refY="4">
              <path d="M0,0 L8,4 L0,8 Z"></path>
            </marker>
          </defs>

          <g class="loop-links">
            <path d="M 134 60 H 222"></path>
            <path d="M 342 60 H 430"></path>
            <path d="M 506 86 V 188"></path>
            <path d="M 430 214 H 342"></path>
            <path d="M 222 214 C 150 214, 122 188, 122 110"></path>
          </g>

          <g class="loop-node-svg">
            <rect x="30" y="38" width="104" height="44" rx="22"></rect>
            <text x="82" y="64">user goal</text>
          </g>
          <g class="loop-node-svg">
            <rect x="222" y="38" width="120" height="44" rx="22"></rect>
            <text x="282" y="64">decide</text>
          </g>
          <g class="loop-node-svg">
            <rect x="430" y="38" width="104" height="44" rx="22"></rect>
            <text x="482" y="64">act</text>
          </g>
          <g class="loop-node-svg">
            <rect x="430" y="192" width="104" height="44" rx="22"></rect>
            <text x="482" y="218">observe</text>
          </g>
          <g class="loop-node-svg is-repeat">
            <rect x="222" y="192" width="120" height="44" rx="22"></rect>
            <text x="282" y="218">update or stop</text>
          </g>

          <text class="loop-caption" x="282" y="148">model decides every turn until done</text>
        </svg>
      </div>
    </div>

    <figure class="code-card code-card--standalone">
      <figcaption>
        <span class="lang-pill">python</span>
        <span class="code-filename">agent_loop.py</span>
        <span class="code-tag">pseudocode</span>
      </figcaption>
      <Code code={agentLoopCode} lang="python" theme="github-light" />
    </figure>

    <p class="mechanism-note">
      In production ADK, the same turn is event-driven — tool calls,
      responses, and state deltas stream back as inspectable events.
    </p>

    <figure class="code-card code-card--standalone">
      <figcaption>
        <span class="lang-pill">python</span>
        <span class="code-filename">runtime_turn.py</span>
        <span class="code-tag">ADK runtime loop</span>
      </figcaption>
      <Code code={runtimeCode} lang="python" theme="github-light" />
    </figure>
  </section>
</SiteLayout>
