---
import '../styles/page.css';
import { url } from '../lib/url';

const {
  current = 'overview',
  description = 'Opinionated agent engineering sharing by Hanyu.',
  title = 'Opinionated Agent Engineering Sharing',
} = Astro.props;

const navItems = [
  { key: 'overview', href: '/', label: 'Overview', kicker: 'Start' },
  { key: 'agent', href: '/what-is-agent/', label: 'What is an agent?', kicker: '01' },
  { key: 'context', href: '/session-state-memory/', label: 'Session, state, memory', kicker: '01A' },
  { key: 'orchestration', href: '/orchestration/', label: 'Design patterns', kicker: '02' },
  { key: 'practice', href: '/engineering-practice/', label: 'Tools & capability', kicker: '03' },
  { key: 'function-tools', href: '/function-tools/', label: 'Function tools', kicker: '03A' },
  { key: 'skills', href: '/skills/', label: 'Skills', kicker: '03B' },
  { key: 'code-execution', href: '/code-execution/', label: 'Code execution', kicker: '03C' },
  { key: 'eval-observability', href: '/eval-observability/', label: 'Eval & observability', kicker: '04' },
  { key: 'harness-engineering', href: '/harness-engineering/', label: 'Harness concept', kicker: '05' },
  { key: 'harness-examples', href: '/harness-examples/', label: 'ADK harness examples', kicker: '05A' },
  { key: 'codeact', href: '/codeact/', label: 'CodeAct Deep Dive', kicker: '06' },
  { key: 'codeact-ds-agent', href: '/codeact-ds-agent/', label: 'A specialized ML agent', kicker: '06A' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <aside class="side-nav" aria-label="Section navigation">
        <a class="brand" href={url('/')}>
          <span>Hanyu's</span>
          <strong>Agent Engineering Notes</strong>
        </a>
        <nav>
          {navItems.map((item) => (
            <a
              class={current === item.key ? 'is-active' : ''}
              href={url(item.href)}
              aria-current={current === item.key ? 'page' : undefined}
            >
              <span>{item.kicker}</span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>
        <a
          class="nav-credit"
          href="https://github.com/whanyu1212/agent-engineering-sharing"
          target="_blank"
          rel="noreferrer"
          aria-label="View source on GitHub"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.17 1.18.92-.26 1.9-.39 2.88-.39s1.96.13 2.88.39c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.77.11 3.06.74.8 1.19 1.82 1.19 3.08 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.04.78 2.1v3.11c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
            />
          </svg>
          <span>Source on GitHub</span>
        </a>
      </aside>

      <main class="content-shell">
        <slot />
      </main>
    </div>
  </body>
</html>
